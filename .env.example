# Server-only connection for an OpenAI-compatible chat-completions provider.
# Copy to .env and fill in your chosen provider. Never use a VITE_ prefix.
QUID_BASE_URL=
QUID_API_KEY=
QUID_MODEL=

# Native Gemini alternative; choose AI_PROVIDER=gemini and set the model ID.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional ordered alternatives, only used after an unavailable, rate-limited or timed-out model.
GEMINI_FALLBACK_MODELS=

# Production and institutional operations.
# NODE_ENV=production
# APP_ORIGIN=https://studentos.example.edu
# HOST=127.0.0.1
# PORT=5080
# STUDENTOS_DATA_DIR=/var/lib/studentos
# TRUST_PROXY=1
# Vercel presentation hosting (separate fictional campus; see DEPLOYMENT.md).
# STUDENTOS_PRESENTATION=1
# BLOB_READ_WRITE_TOKEN=configure-as-a-Vercel-secret
# Transactional mail adapter: POST {from,to,subject,text} with Bearer token.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
MAIL_FROM=

# Institution identity must match the bootstrap administrator.
COLLEGE_ID=hkbk-college-of-engineering
COLLEGE_NAME=HKBK College of Engineering
# Optional authorized opportunity JSON feed.
OPPORTUNITY_FEED_URL=
OPPORTUNITY_FEED_TOKEN=
# Isolated multi-language runner; see OPERATIONS.md for its contract.
JUDGE_URL=
JUDGE_TOKEN=
