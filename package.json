{
  "name": "studentos-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/build-assessment-kits.mjs",
    "build": "vite build",
    "build:vercel": "node scripts/build-presentation-seed.mjs && npm run build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "check": "node scripts/check.mjs",
    "format": "node scripts/check.mjs --format",
    "load:check": "node scripts/load-check.mjs",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@vercel/blob": "2.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/generator": "7.29.8",
    "@babel/parser": "7.29.8",
    "@babel/traverse": "7.29.8",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": "24.x"
  }
}
